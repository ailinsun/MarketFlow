# MarketFlow configuration. Copy to .env and edit; .env is git-ignored.
# Every value here is a placeholder. Nothing in this file is a secret.
#
# Nothing below is required to run `make verify` or `make demo`. Both run offline,
# with no credentials, and with the network denied by the test runner's audit hook.
#
# Full reference, including what happens when each is unset:
#   docs/configuration.md

# ── where state is written ───────────────────────────────────────────────────
# Ledgers, arm state, caches and heartbeats. Defaults to <project>/runtime, which
# is fine for a checkout and wrong for an installed package.
MARKETFLOW_RUNTIME=/var/lib/marketflow

# ── risk limits: fractions of these, never dollar constants ──────────────────
# Set these from your own mandate. The defaults are illustrative, not advice.
MARKETFLOW_CAPITAL_BASE_USD=1000000
MARKETFLOW_MANDATE_CAPITAL_USD=1000000
MARKETFLOW_FLEET_CAPITAL_USD=10000000

# ── hard gates. Unset means closed, which is the safe state ──────────────────
# Comma-separated signal sources allowed to open a position. Unset: none.
MARKETFLOW_ENTRY_SOURCES=
# Minimum signers on a root authority. Floored at 2; raising it is allowed.
MARKETFLOW_MIN_ROOT_QUORUM=2
# Touch this file to halt execution.
MARKETFLOW_POLYMARKET_KILL=/var/lib/marketflow/KILL

# ── pluggable seams. Unconfigured means deny, not allow ──────────────────────
# Dotted module path routing a market to its intelligence sources.
MARKETFLOW_INTEL_ROUTER=

# ── signing layer (only needed to place real orders) ─────────────────────────
MARKETFLOW_GUARDIAN_ROOT=/var/lib/marketflow/guardian
MARKETFLOW_GUARDIAN_MASTER_KEY=/var/lib/marketflow/secrets/master.key
MARKETFLOW_TURNKEY_API_BASE=https://api.turnkey.com
# Loopback-only control API for the signing service.
MARKETFLOW_GUARDIAN_HTTP_HOST=127.0.0.1
MARKETFLOW_GUARDIAN_HTTP_PORT=8790
MARKETFLOW_GUARDIAN_HTTP_TOKEN_FILE=/var/lib/marketflow/secrets/http.token
# Gate files live under MARKETFLOW_GUARDIAN_ROOT and are absent by default, which
# means closed. A deployment creates GUARDIAN_LIVE_ENABLED, GUARDIAN_ENTRY_ENABLED,
# GUARDIAN_USER_ROOT_ENABLED or GUARDIAN_TURNKEY_ENABLED deliberately; nothing in
# the service ever creates one.

# ── operator alerts. Unconfigured: alerts are dropped and report False ───────
MARKETFLOW_ALERT_WEBHOOK=
MARKETFLOW_ALERT_BOT_TOKEN=
MARKETFLOW_ALERT_CHAT_ID=

# ── optional local inputs ────────────────────────────────────────────────────
MARKETFLOW_WHALE_FEED=
# Egress proxy for venue traffic, when a deployment routes through one.
# Unset: connections go direct.
MARKETFLOW_POLYMARKET_PROXY_URL=
# UMA subgraph base for settlement history. Unset: that layer reports unavailable.
MARKETFLOW_UMA_SUBGRAPH_BASE=
# Where the read-only data plane keeps its risk state.
MARKETFLOW_RISK_STATE_DIR=/var/lib/marketflow/risk
# Port for that data plane. It binds loopback only.
MARKETFLOW_MCP_PORT=8791
MARKETFLOW_FEED_MAX_ACTIVE_BYTES=268435456
MARKETFLOW_NIGHT_RULE_ENABLED=0
