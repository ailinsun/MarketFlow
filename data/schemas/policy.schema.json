{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ailinsun/MarketFlow/blob/main/data/schemas/policy.schema.json",
  "title": "MarketFlow Institutional Risk Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "venue_scope", "category_scope", "maximum_position_size",
    "maximum_event_concentration_pct", "maximum_resolution_source_concentration_pct",
    "maximum_acceptable_exit_slippage_pct", "minimum_executable_exit_depth",
    "allowed_risk_bands", "unknown_safety_critical_action", "block_on_active_dispute",
    "block_on_rules_change_pending_review", "block_on_stale_evidence",
    "block_on_settlement_basis_mismatch", "warn_before_deadline_hours",
    "reduce_target_pct", "exit_target_pct", "decision_ttl_seconds",
    "approval_ttl_seconds", "override_ttl_seconds",
    "escalate_on_human_review_required", "allow_block_override",
    "require_distinct_control_actor"
  ],
  "properties": {
    "schema_version": {"const": "marketflow-policy-v1.0.0"},
    "venue_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["polymarket", "kalshi", "*"]}},
    "category_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "maximum_position_size": {"type": "number", "minimum": 0},
    "maximum_event_concentration_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "maximum_resolution_source_concentration_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "maximum_acceptable_exit_slippage_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "minimum_executable_exit_depth": {"type": "number", "minimum": 0},
    "allowed_risk_bands": {"type": "array", "uniqueItems": true, "items": {"enum": ["low", "medium", "high", "unknown"]}},
    "unknown_safety_critical_action": {"enum": ["BLOCK", "ESCALATE", "WARN"], "description": "ALLOW is intentionally invalid."},
    "block_on_active_dispute": {"type": "boolean"},
    "block_on_rules_change_pending_review": {"type": "boolean"},
    "block_on_stale_evidence": {"type": "boolean"},
    "block_on_settlement_basis_mismatch": {"type": "boolean"},
    "warn_before_deadline_hours": {"type": "number", "minimum": 0},
    "reduce_target_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "exit_target_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "decision_ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "approval_ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "override_ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "escalate_on_human_review_required": {"type": "boolean"},
    "allow_block_override": {"type": "boolean"},
    "require_distinct_control_actor": {"type": "boolean"},
    "effective_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
